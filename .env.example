# Copy to .env (repo root). Everything is optional: with no keys at all, Ferry runs locally with
# rule-based answers, the sandbox mailbox, logged texts, and local "plan" credits.

# --- Server ---------------------------------------------------------------------
PORT=8787
PUBLIC_URL=http://localhost:8787          # public origin of the API (webhooks, OAuth callbacks)
# WEB_URL=                                 # where the dashboard lives if not served by the API (Vite dev: http://localhost:5173)
# CORS_ORIGINS=https://ferry.example.com,capacitor://localhost,https://localhost
# DATA_DIR=data
# VAULT_KEY=                               # base64 32-byte key for secrets at rest (else generated under DATA_DIR)

# --- Accounts ---------------------------------------------------------------------
# dev = passwordless email sign-in (single-user/local); password = passwords + email verification + magic links
AUTH_MODE=dev
FREE_CREDITS=25

# --- AI (Claude) ----------------------------------------------------------------
# Used for match reasoning, résumé tailoring, cover letters, open-ended answers, page navigation,
# and email classification. Without it, deterministic fallbacks run.
# AI: NVIDIA NIM (DeepSeek v4.1 by default) or Anthropic. Without either, every AI feature uses its rule-based fallback.
NVIDIA_NIM_API_KEY=
# LLM_MODEL=deepseek-ai/deepseek-v4.1-flash                 # writing: tailoring, cover letters, answers, edits
# LLM_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b      # quick tasks: match scores, inbox, extraction ("" = main model)
# LLM_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b
# LLM_DEBUG=1                                               # log raw model replies
# LLM_TIMEOUT_MS=120000
# LLM_CONCURRENCY=4
ANTHROPIC_API_KEY=
# LLM_PROVIDER=anthropic   (use Claude even when a NIM key is set; LLM_MODEL=claude-opus-5-5)
# LLM_DISABLED=false

# --- Apply agent -------------------------------------------------------------------
# Real employer forms are filled and then STOPPED before the final submit (and files aren't
# uploaded) unless this is true. The local sandbox employers always submit.
ALLOW_REAL_SUBMIT=false
HEADLESS=true                              # false = watch the browser work
APPLY_CONCURRENCY=2

# --- Discovery ----------------------------------------------------------------------
POLL_INTERVAL_MIN=120
POLL_ON_BOOT=true
# WORKDAY_MAX_JOBS=300                     # per Workday board per sweep

# --- Outbound email (verification, magic links, digests) ---------------------------
RESEND_API_KEY=
MAIL_FROM=Ferry <noreply@ferry.local>

# --- Reading the user's inbox (tracking + employer verification codes) --------------
# Gmail OAuth (readonly). Redirect URI: {PUBLIC_URL}/api/v1/integrations/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# (Users can also connect any inbox over IMAP with an app password from Settings → Email.)

# --- Billing (Stripe Checkout) -------------------------------------------------------
# Webhook endpoint: {PUBLIC_URL}/api/v1/webhooks/stripe  (events: checkout.session.completed,
# invoice.paid, customer.subscription.updated, customer.subscription.deleted)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_POWER=

# --- Texting (apply by SMS / WhatsApp / iMessage) -------------------------------------
# Twilio inbound webhook: {PUBLIC_URL}/api/v1/webhooks/twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                               # +1...
TWILIO_WHATSAPP_FROM=                      # +1... (WhatsApp-enabled sender)
# Sendblue (iMessage) inbound webhook: {PUBLIC_URL}/api/v1/webhooks/sendblue?secret=SENDBLUE_WEBHOOK_SECRET
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM=
SENDBLUE_WEBHOOK_SECRET=

# --- Push notifications ------------------------------------------------------------------
# Web push keys are generated automatically; set these to pin them across deploys.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# Native apps (iOS/Android via FCM): path to a Firebase service-account JSON
# FCM_SERVICE_ACCOUNT=/data/firebase-service-account.json
